
//Windows rules configuration

workspace "browser"

// Window rule for all windows. At the moment it rounds the window corners
window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}

//Firefox

// Open the Firefox picture-in-picture player as floating by default.
window-rule {
    match app-id=r#"firefox$"# title=r#"(Picture-in-Picture|Картинка в картинке)$"#
    open-floating true

    default-column-width {
        fixed 480 
    }

    default-window-height {
        fixed 270
    }

    default-floating-position x=32 y=32 relative-to="bottom-left"
}

//Open the Firefox as maximized window by default
window-rule {
    match app-id=r#"firefox$"#
    exclude title=r#"(Picture-in-Picture|Картинка в картинке)$"# 
    open-maximized true
    open-on-workspace "browser"
}
